{
  "name": "nine-lives-corp-poc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build && mkdir -p dist/server && cp worker/index.js dist/server/index.js",
    "check": "npm run check --workspace @nine-lives/game-core && vue-tsc -b",
    "test": "npm run test --workspace @nine-lives/game-core && node --test src/*.test.ts src/world/*.test.ts",
    "test:smoke": "node --test packages/game-core/test/poc-flow.smoke.test.ts src/ui-flow.smoke.test.ts",
    "test:ui": "node --test src/ui-flow.smoke.test.ts",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:firefox:install": "playwright install firefox"
  },
  "dependencies": {
    "@nine-lives/game-core": "0.1.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.2.0"
  }
}
